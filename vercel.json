{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/geo/:ruta*",
      "destination": "https://geoportal.tresdefebrero.gob.ar/:ruta*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
