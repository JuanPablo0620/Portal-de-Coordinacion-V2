# Copiar a `.env.local` (ese sí se ignora en git) y completar con los valores
# reales — pedirlos a quien tenga acceso al proyecto de Supabase.
#
# VITE_SUPABASE_ANON_KEY es la clave pública `anon`, la que acepta que viaje
# en el bundle del frontend. NUNCA poner acá la `service_role` — esa se salta
# los permisos y no tiene que salir de un script de servidor.
VITE_SUPABASE_URL=https://bqwrnzjvkwtzlcnguwnz.supabase.co
VITE_SUPABASE_ANON_KEY=

# Convocatorias: cliente OAuth de tipo aplicación web (ID público, sin secreto).
# Habilitar Gmail, Calendar y Drive API y autorizar el origen del portal.
# La carpeta es «01. Seguimiento por Secretarias», no la raíz del Drive.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_SEGUIMIENTO_FOLDER_ID=
